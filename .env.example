# Copy to `.env` and adjust. Picked up automatically by `npx mcp-rag-memory`,
# `npm run dev`, and `npm run start` (see src/env.ts). Host environment
# variables always override these values.

# Where the SQLite store lives (default: <project>/.rag-data)
RAG_DB_DIR=.rag-data

# Embedding backend: "local" (zero-dep, offline) | "transformers" (ONNX, higher quality)
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Search mode: "hybrid" | "vector" | "keyword"
SEARCH_MODE=hybrid

# Recency decay half-life for memory recall scores (days)
RAG_MEMORY_HALF_LIFE_DAYS=14

# Ingestion guards
RAG_MAX_FILE_MB=10
# RAG_ALLOWED_DIRS=C:\repo\a;C:\repo\b

# Session auto-sync / condensing (opencode plugin reads these from its own env)
RAG_AUTOSYNC=1
RAG_SESSION_CONDENSE=1
RAG_SESSION_CONDENSE_MIN_CHARS=120
RAG_SESSION_CONDENSE_RATIO=0.35

# Optional pruning during consolidation
RAG_PRUNE=0
RAG_PRUNE_IMPORTANCE=0.2
RAG_PRUNE_AGE_DAYS=90

# opencode transcript sources (override autodetect)
# OPENCODE_DB=C:\Users\you\.local\share\opencode\opencode.db
# OPENCODE_DB_LOCAL=C:\Users\you\.local\share\opencode\opencode-local.db