{
  "name": "mcp-rag-memory",
  "version": "2.2.0",
  "description": "RAG + Context Management MCP server: long-term memory, vector storage, knowledge retrieval. Run with npx, zero external APIs.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "mcp-rag-memory": "dist/mcp/rag-server.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "oxlint src --deny-warnings",
    "start": "node dist/mcp/rag-server.js",
    "dev": "tsx src/mcp/rag-server.ts",
    "cli": "tsx src/cli.ts",
    "sync-logs": "tsx src/cli.ts sync-logs",
    "sync-session": "tsx src/cli.ts sync-session",
    "test": "tsx src/test/test-all.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "rag",
    "memory",
    "vector-search",
    "context-management",
    "node"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "oxlint": "^1.83.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0"
  }
}
